#!/bin/bash
set -e

echo "🔨 Building Safe Mother Malawi for Web..."

# Backup pubspec.yaml
cp pubspec.yaml pubspec.yaml.bak

# Remove firebase_messaging from pubspec.yaml
# This sed command removes the line containing "firebase_messaging:" and the next line if it starts with spaces
sed -i '/^  firebase_messaging:/,/^  [a-z]/{ /^  [a-z]/!d; }' pubspec.yaml

echo "✓ Removed firebase_messaging from pubspec.yaml"

# Run flutter pub get
echo "📦 Running flutter pub get..."
flutter/bin/flutter pub get

# Build for web
echo "🌐 Building Flutter web app..."
flutter/bin/flutter build web --release --dart-define=FLUTTER_WEB_USE_SKIA=true

# Restore pubspec.yaml
mv pubspec.yaml.bak pubspec.yaml

echo "✅ Web build completed successfully!"
